# Copy this file to .env and fill in real values. Never commit the real .env.

# Zoho Catalyst Configuration
ZOHO_ORG_ID=your-catalyst-org-id
ZOHO_PROJECT_ID=your-catalyst-project-id
ZOHO_RAG_ENDPOINT=https://your-catalyst-rag-endpoint
ZOHO_DOCUMENT_IDS=comma,separated,document,ids
ZIA_TRANSLATE_ENDPOINT=https://your-catalyst-zia-endpoint

# The real 30-table schema lives in the Development environment — Catalyst defaults to
# Production/Live if this header is missing, which only had 5 stale tables.
APP_CATALYST_ENV=Development

# Security Credentials
ZIA_OAUTH_CLIENT_ID=your-zoho-client-id
ZIA_OAUTH_CLIENT_SECRET=your-zoho-client-secret
ZIA_OAUTH_REFRESH_TOKEN=your-zoho-refresh-token

# App Auth (JWT) — keep this secret out of version control
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Catalyst Data Store governance tables (create these in the Catalyst console — see README)
APP_USER_TABLE=AppUser
AUDIT_LOG_TABLE=AuditLog
CHAT_HISTORY_TABLE=ChatHistory

# Voice I/O (ElevenLabs — speech-to-text + text-to-speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Automatic-failover fallback LLM provider (chat/llm_provider.py) — Zia stays
# primary; Groq is only used when Zia's circuit breaker trips (2 consecutive
# failures or p95 latency > 15s) or for fast/structured tasks where whichever
# provider is currently faster is preferred. Get a free key at
# https://console.groq.com/keys. Leaving this unset is fine — the app runs
# Zia-only, exactly as before this feature existed.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Primary provider for answer composition (chat/llm_provider.py) — Google AI
# Studio's free tier. Get a free key at https://aistudio.google.com/apikey.
# Used for answer composition (all languages, including Hindi/Kannada) and as
# classification's 2nd-tier fallback if Groq is rate-limited — Groq itself is
# NEVER used for composition. Leaving this unset is fine — composition falls
# back to Zia. Google's free tier partitions quota PER MODEL NAME (~20
# req/day on some aliases) — see core/config.py's comment on GEMINI_MODEL if
# this starts 429ing.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
